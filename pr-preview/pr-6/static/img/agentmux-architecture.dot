digraph G {
  rankdir=LR;
  graph [bgcolor="transparent", pad="0.2", nodesep="0.55", ranksep="0.9"];
  node [shape=box, style="rounded,filled", fontname="Menlo", fontsize=12, color="#2b3440", fillcolor="#f7f7f4", fontcolor="#20252b", margin="0.16,0.1"];
  edge [color="#5f6b7a", penwidth=1.4, arrowsize=0.8];

  ui [label="desktop UI\nworkspaces · tabs · splits", fillcolor="#d9eef7"];
  tmux [label="tmux -L agentmux\ndurable sessions", fillcolor="#d9f3df"];
  agent [label="Claude / Codex panes", fillcolor="#e6eefb"];
  detect [label="buffer heuristics\nworking / needs-input", fillcolor="#fdecc8"];
  notify [label="desktop notifications", fillcolor="#f4d9ff"];
  shell [label="external shell attach", fillcolor="#f9d9d9"];

  ui -> tmux -> agent -> detect -> notify;
  shell -> tmux;
}
